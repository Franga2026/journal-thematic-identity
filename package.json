{
  "name": "directorio-uta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:data && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:data": "node scripts/verify-data.mjs",
    "verify:data:stubs": "node scripts/verify-data.mjs --allow-stubs",
    "setup:data": "node scripts/setup-data.mjs",
    "restore:data": "node scripts/setup-data.mjs && npm run link:works && npm run index:citations",
    "link:works": "node scripts/link-autores-uta.mjs",
    "index:citations": "npx vite-node scripts/index-citations.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.0",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
