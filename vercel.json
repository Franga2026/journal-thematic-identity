{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:data:stubs && npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ai/*.ts": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    },
    "api/report/*.ts": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    }
  }
}
